# =============================================================================
# fund_pooling 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# =============================================================================

COMPOSE_PROJECT_NAME=fund_pooling
TZ=Asia/Shanghai
APP_VERSION=0.1.0

# ----------------------------------------------------------------------------
# Django
# ----------------------------------------------------------------------------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# 本地 runserver 用 true；docker compose 会强制覆盖为 false
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_LOG_LEVEL=INFO
# 对外域名启用 HTTPS 时按需补充，逗号分隔
# CSRF_TRUSTED_ORIGINS=https://fund-pooling.example.com
# CORS_ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_DB=fund_pooling
POSTGRES_USER=fund_pooling
POSTGRES_PASSWORD=change-me
# 映射到宿主机的端口（仅 127.0.0.1 可访问）
POSTGRES_PORT_HOST=5432

# 数据库数据目录（宿主机绝对路径），数据写入其下 pgdata/ 子目录
PGDATA_HOST_PATH="/Users/你的用户名/Code/fund_pooling/database"

# 备份输出目录：pg_dump 生成的 .dump 写到这里，可指向本地磁盘、NAS 或云同步目录。
# 注意：路径若含空格，需要用引号包起来。
BACKUP_HOST_PATH="/Users/你的用户名/backups/fund_pooling"

# 备份保留天数
BACKUP_KEEP_DAYS=14

# ----------------------------------------------------------------------------
# Web 服务
# ----------------------------------------------------------------------------
WEB_PORT=8000
# 可选：镜像仓库名
# WEB_IMAGE=fund_pooling/web

# 可选：首次启动自动创建 Django 超级用户（已存在则跳过）
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# ----------------------------------------------------------------------------
# 容器内访问境外服务（可选）
# ----------------------------------------------------------------------------
# 后端校验 Google 登录需要访问 www.googleapis.com，而容器不继承宿主机的系统代理。
# 默认经 host.docker.internal 指向宿主机的代理端口；不需要代理的部署留空即可。
# CONTAINER_PROXY=http://host.docker.internal:1082
# CONTAINER_PROXY=
# CONTAINER_NO_PROXY=localhost,127.0.0.1,::1,db

# 可选：Gunicorn 调优
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=60

# ----------------------------------------------------------------------------
# 第三方登录
# ----------------------------------------------------------------------------
# Apple Sign In：需要付费的 Apple Developer Program（¥688/年）才能创建 Service ID
# APPLE_CLIENT_ID=com.example.fundpooling.web
# Google Sign In：Google Cloud Console → OAuth 2.0 客户端 ID（Web 应用），免费
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
